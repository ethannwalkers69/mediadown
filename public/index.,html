<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#090d18" />
  <meta name="description" content="Download media from Facebook, YouTube and Spotify in one place." />
  <title>MediaDown — All-in-One Downloader</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      color-scheme: dark;
      --bg:#090d18; --panel:#111827; --panel2:#151f31; --line:rgba(148,163,184,.15);
      --text:#f4f7fb; --muted:#91a0b7; --accent:#7c6cff; --accent2:#38bdf8;
      --green:#22c55e; --danger:#fb7185; --shadow:0 24px 80px rgba(0,0,0,.32);
    }
    [data-theme="light"] {
      color-scheme:light; --bg:#f3f6fc; --panel:#fff; --panel2:#f7f9fe; --line:rgba(35,49,75,.12);
      --text:#142033; --muted:#64748b; --accent:#635bdb; --accent2:#0284c7; --shadow:0 24px 70px rgba(35,49,75,.10);
    }
    *{box-sizing:border-box}
    body{margin:0;background:radial-gradient(ellipse at 80% -10%,rgba(124,108,255,.18),transparent 38%),var(--bg);color:var(--text);font-family:"DM Sans",sans-serif;min-height:100vh;transition:background .25s,color .25s}
    button,input,select{font:inherit}
    button{cursor:pointer}
    .app{display:flex;min-height:100vh}
    .sidebar{width:250px;padding:26px 18px;border-right:1px solid var(--line);background:rgba(10,15,27,.72);backdrop-filter:blur(18px);position:fixed;inset:0 auto 0 0;z-index:5;display:flex;flex-direction:column}
    [data-theme="light"] .sidebar{background:rgba(255,255,255,.82)}
    .brand{display:flex;align-items:center;gap:12px;padding:4px 10px 34px;font:700 21px "Space Grotesk",sans-serif;letter-spacing:-.7px}
    .brand-mark{width:39px;height:39px;border-radius:13px;display:grid;place-items:center;background:linear-gradient(135deg,#8b5cf6,#38bdf8);box-shadow:0 8px 25px #6d5df455;color:white;font-size:21px}
    .nav-label{font-size:10px;letter-spacing:1.7px;color:var(--muted);font-weight:800;padding:0 12px 12px}
    .nav{display:grid;gap:6px}
    .nav button{border:0;background:transparent;color:var(--muted);display:flex;align-items:center;gap:13px;padding:12px;border-radius:12px;text-align:left;font-weight:600;transition:.2s}
    .nav button:hover,.nav button.active{background:linear-gradient(100deg,rgba(124,108,255,.18),rgba(56,189,248,.06));color:var(--text)}
    .nav button.active{box-shadow:inset 3px 0 var(--accent)}
    .nav-icon{width:22px;text-align:center;font-size:17px}
    .sidebar-bottom{margin-top:auto}
    .side-note{padding:15px;border:1px solid var(--line);border-radius:15px;background:var(--panel);font-size:12px;color:var(--muted);line-height:1.6}
    .side-note strong{color:var(--text);display:block;margin-bottom:4px}
    .main{margin-left:250px;width:calc(100% - 250px);padding:30px clamp(20px,4vw,58px) 70px;max-width:1600px}
    .topbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:45px}
    .crumb{color:var(--muted);font-size:13px}.crumb b{color:var(--text)}
    .top-actions{display:flex;gap:10px}
    .icon-btn{width:42px;height:42px;border:1px solid var(--line);border-radius:13px;background:var(--panel);color:var(--text);display:grid;place-items:center;font-size:17px}
    .hero{max-width:820px;margin:0 auto 28px;text-align:center}
    .eyebrow{display:inline-flex;align-items:center;gap:8px;padding:7px 12px;border:1px solid rgba(124,108,255,.3);border-radius:99px;background:rgba(124,108,255,.09);color:#b9b1ff;font-size:11px;font-weight:800;letter-spacing:1.2px;text-transform:uppercase}
    [data-theme="light"] .eyebrow{color:#6257cf}
    h1{font:700 clamp(34px,5vw,58px)/1.08 "Space Grotesk",sans-serif;letter-spacing:-2.5px;margin:20px 0 14px}
    .gradient{background:linear-gradient(100deg,#a78bfa,#60a5fa,#5eead4);-webkit-background-clip:text;background-clip:text;color:transparent}
    .hero p{color:var(--muted);font-size:15px;line-height:1.7;margin:0 auto;max-width:560px}
    .download-card{max-width:850px;margin:32px auto 24px;padding:22px;border:1px solid var(--line);border-radius:22px;background:linear-gradient(145deg,var(--panel),var(--panel2));box-shadow:var(--shadow)}
    .platforms{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:18px}
    .platform{border:1px solid var(--line);background:var(--bg);color:var(--muted);border-radius:13px;padding:13px 10px;display:flex;align-items:center;justify-content:center;gap:9px;font-weight:700;transition:.2s}
    .platform:hover{transform:translateY(-2px);border-color:#7c6cff88}
    .platform.selected{color:var(--text);border-color:#8b7cff;background:rgba(124,108,255,.13);box-shadow:0 0 0 3px rgba(124,108,255,.08)}
    .platform .picon{font-size:19px}
    .input-label{display:block;color:var(--muted);font-size:12px;font-weight:700;margin:0 0 9px 2px}
    .url-wrap{display:flex;gap:10px}
    .url-input{min-width:0;flex:1;background:var(--bg);border:1px solid var(--line);border-radius:13px;padding:16px;color:var(--text);outline:none;transition:.2s}
    .url-input:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(124,108,255,.12)}
    .url-input::placeholder{color:var(--muted)}
    .quality-row{display:flex;align-items:center;gap:10px;margin-top:13px;color:var(--muted);font-size:12px}
    .quality-row select{background:var(--bg);color:var(--text);border:1px solid var(--line);border-radius:9px;padding:8px 10px;outline:none}
    .primary{border:0;border-radius:13px;padding:0 23px;background:linear-gradient(110deg,#765cf5,#3989ed);color:white;font-weight:800;box-shadow:0 9px 25px rgba(103,92,245,.24);transition:.2s;white-space:nowrap}
    .primary:hover{transform:translateY(-2px);filter:brightness(1.1)}
    .primary:disabled{opacity:.55;cursor:wait;transform:none}
    .status{display:none;margin-top:17px;padding:14px;border-radius:12px;background:var(--bg);border:1px solid var(--line);font-size:13px;line-height:1.5;color:var(--muted);overflow-wrap:anywhere}
    .status.show{display:block}.status.error{border-color:#fb718555;color:var(--danger)}.status.success{border-color:#22c55e55;color:var(--green)}
    .result-links{display:grid;gap:8px;margin-top:10px}
    .result-link{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:11px 12px;border:1px solid var(--line);border-radius:10px;color:var(--text);text-decoration:none;background:var(--panel)}
    .result-link:hover{border-color:var(--accent)}
    .result-link span{font-size:12px;overflow-wrap:anywhere}
    .section-title{font:700 19px "Space Grotesk",sans-serif;letter-spacing:-.4px;margin:40px 0 15px}
    .feature-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;max-width:1000px;margin:0 auto}
    .feature{padding:18px;border:1px solid var(--line);border-radius:17px;background:var(--panel)}
    .feature-icon{width:39px;height:39px;border-radius:12px;display:grid;place-items:center;background:rgba(124,108,255,.13);font-size:18px;margin-bottom:14px}
    .feature h3{font-size:14px;margin:0 0 7px}.feature p{font-size:12px;line-height:1.6;color:var(--muted);margin:0}
    .page{display:none;max-width:950px;margin:0 auto}.page.active{display:block}
    .page-head{margin-bottom:25px}.page-head h1{font-size:36px;margin:0 0 8px;letter-spacing:-1.5px}.page-head p{color:var(--muted);margin:0;line-height:1.6}
    .setting-card,.info-card{padding:20px;border:1px solid var(--line);border-radius:16px;background:var(--panel);margin-bottom:13px}
    .setting-row{display:flex;align-items:center;justify-content:space-between;gap:20px}.setting-row strong{font-size:14px}.setting-row p{font-size:12px;color:var(--muted);margin:5px 0 0}
    .toggle{width:45px;height:25px;border:0;border-radius:99px;background:#475569;padding:3px;flex:none}.toggle:after{content:"";display:block;width:19px;height:19px;border-radius:50%;background:white;transition:.2s}.toggle.on{background:var(--accent)}.toggle.on:after{transform:translateX(20px)}
    .info-card h3{margin:0 0 8px;font:700 16px "Space Grotesk"}.info-card p,.info-card li{color:var(--muted);font-size:13px;line-height:1.7}
    .info-card ul{padding-left:18px;margin-bottom:0}
    .history-empty{text-align:center;padding:55px 20px;border:1px dashed var(--line);border-radius:16px;color:var(--muted)}
    .history-empty div{font-size:32px;margin-bottom:12px}
    .mobile-brand{display:none}
    .toast{position:fixed;bottom:22px;left:50%;transform:translate(-50%,20px);opacity:0;pointer-events:none;background:var(--text);color:var(--bg);padding:11px 16px;border-radius:10px;font-size:12px;font-weight:700;transition:.25s;z-index:20}.toast.show{opacity:1;transform:translate(-50%,0)}
    pre{white-space:pre-wrap;overflow-wrap:anywhere;background:var(--bg);padding:12px;border-radius:10px;color:var(--muted);font-size:11px;max-height:240px;overflow:auto}
    @media(max-width:850px){.sidebar{width:215px}.main{margin-left:215px;width:calc(100% - 215px);padding:24px 22px 55px}.feature-grid{grid-template-columns:1fr 1fr}}
    @media(max-width:650px){
      .sidebar{inset:auto 0 0;width:100%;height:68px;padding:7px 10px;border-right:0;border-top:1px solid var(--line);flex-direction:row;justify-content:center;background:rgba(10,15,27,.94)}
      [data-theme="light"] .sidebar{background:rgba(255,255,255,.96)}
      .brand,.nav-label,.sidebar-bottom{display:none}.nav{width:100%;grid-template-columns:repeat(5,1fr);gap:2px}.nav button{padding:7px 2px;display:flex;flex-direction:column;justify-content:center;gap:3px;font-size:10px;border-radius:9px}.nav button.active{box-shadow:inset 0 2px var(--accent)}.nav-icon{font-size:17px}
      .main{margin:0;width:100%;padding:20px 15px 95px}.topbar{margin-bottom:34px}.mobile-brand{display:flex;align-items:center;gap:9px;font:700 17px "Space Grotesk"}.mobile-brand .brand-mark{width:32px;height:32px;border-radius:10px;font-size:17px}
      .topbar .crumb{display:none}.hero h1{letter-spacing:-1.6px}.hero p{font-size:13px}.download-card{padding:14px;margin-top:24px;border-radius:18px}.platforms{gap:6px}.platform{padding:12px 5px;flex-direction:column;gap:5px;font-size:11px}.platform .picon{font-size:20px}
      .url-wrap{flex-direction:column}.url-input{padding:15px}.primary{height:48px}.quality-row{flex-wrap:wrap}.feature-grid{grid-template-columns:1fr}.section-title{margin-top:32px}.page-head h1{font-size:30px}
    }
  </style>
</head>
<body>
<div class="app">
  <aside class="sidebar">
    <div class="brand"><div class="brand-mark">↓</div><span>Media<span class="gradient">Down</span></span></div>
    <div class="nav-label">WORKSPACE</div>
    <nav class="nav" aria-label="Main navigation">
      <button class="active" data-page="home"><span class="nav-icon">⌂</span>Home</button>
      <button data-page="history"><span class="nav-icon">◷</span>History</button>
      <button data-page="settings"><span class="nav-icon">⚙</span>Settings</button>
      <button data-page="info"><span class="nav-icon">ⓘ</span>Info</button>
      <button data-page="more"><span class="nav-icon">⋯</span>More</button>
    </nav>
    <div class="sidebar-bottom"><div class="side-note"><strong>Made for easy downloads</strong>One simple place for your favorite media links.</div></div>
  </aside>

  <main class="main">
    <header class="topbar">
      <div class="crumb">Workspace <span> / </span> <b id="crumbName">Home</b></div>
      <div class="mobile-brand"><div class="brand-mark">↓</div>Media<span class="gradient">Down</span></div>
      <div class="top-actions"><button class="icon-btn" id="themeQuick" title="Toggle theme" aria-label="Toggle theme">☼</button></div>
    </header>

    <section class="page active" id="page-home">
      <div class="hero">
        <div class="eyebrow">✦ All-in-one media tool</div>
        <h1>Your media. <span class="gradient">One download.</span></h1>
        <p>Paste a supported link and let MediaDown prepare your download. Simple, quick, and designed for every screen.</p>
      </div>
      <div class="download-card">
        <div class="platforms">
          <button class="platform selected" data-platform="facebook"><span class="picon">ⓕ</span>Facebook</button>
          <button class="platform" data-platform="youtube"><span class="picon">▶</span>YouTube</button>
          <button class="platform" data-platform="spotify"><span class="picon">♫</span>Spotify</button>
        </div>
        <label class="input-label" for="mediaUrl">PASTE YOUR LINK</label>
        <div class="url-wrap">
          <input class="url-input" id="mediaUrl" type="url" placeholder="https://..." autocomplete="off" />
          <button class="primary" id="downloadBtn">↓ &nbsp; Download</button>
        </div>
        <div class="quality-row" id="qualityRow">
          <label for="quality">Video quality</label>
          <select id="quality">
            <option value="auto">Auto / API default</option><option value="360p">360p</option><option value="480p">480p</option><option value="720p">720p</option><option value="1080p">1080p</option>
          </select>
          <span>MP4</span>
        </div>
        <div class="status" id="status" aria-live="polite"></div>
      </div>
      <h2 class="section-title">Built for a smoother experience</h2>
      <div class="feature-grid">
        <article class="feature"><div class="feature-icon">⚡</div><h3>Quick processing</h3><p>Send your link to the connected downloader service and view its response.</p></article>
        <article class="feature"><div class="feature-icon">◈</div><h3>Simple interface</h3><p>A clean workspace that keeps the main download action front and center.</p></article>
        <article class="feature"><div class="feature-icon">▣</div><h3>Mobile ready</h3><p>Responsive layout with bottom navigation on smaller screens.</p></article>
      </div>
    </section>

    <section class="page" id="page-history">
      <div class="page-head"><h1>Download history</h1><p>Your recent requests on this device.</p></div>
      <div id="historyList"></div>
    </section>

    <section class="page" id="page-settings">
      <div class="page-head"><h1>Settings</h1><p>Adjust the way MediaDown looks and behaves.</p></div>
      <div class="setting-card"><div class="setting-row"><div><strong>Dark appearance</strong><p>Switch between dark and light themes.</p></div><button class="toggle on" id="themeToggle" aria-label="Toggle dark appearance"></button></div></div>
      <div class="setting-card"><div class="setting-row"><div><strong>Remember recent links</strong><p>Keep a local list of your recent download requests.</p></div><button class="toggle on" id="historyToggle" aria-label="Toggle download history"></button></div></div>
      <div class="setting-card"><div class="setting-row"><div><strong>Clear history</strong><p>Remove saved request history from this browser.</p></div><button class="icon-btn" id="clearHistory" title="Clear history">⌫</button></div></div>
    </section>

    <section class="page" id="page-info">
      <div class="page-head"><h1>About MediaDown</h1><p>A simple multi-platform downloader interface.</p></div>
      <div class="info-card"><h3>What is MediaDown?</h3><p>MediaDown provides one interface for submitting Facebook, YouTube and Spotify links to third-party downloader APIs. Processing and download availability depend on those external services.</p></div>
      <div class="info-card"><h3>How to use</h3><ul><li>Choose Facebook, YouTube or Spotify.</li><li>Paste a link from the selected platform.</li><li>Choose a video quality when using YouTube.</li><li>Press Download and use the returned download link if the service provides one.</li></ul></div>
      <div class="info-card"><h3>Privacy</h3><p>Theme and recent request history are stored locally in your browser. Links are sent to the configured third-party API when you request processing. Do not submit private or sensitive URLs.</p></div>
      <div class="info-card"><h3>Responsible use</h3><p>Only download content you own or have permission to save. Follow each platform's terms, copyright rules and applicable laws. Spotify content may be subject to platform restrictions; this site does not bypass subscriptions or access controls.</p></div>
    </section>

    <section class="page" id="page-more">
      <div class="page-head"><h1>More</h1><p>Helpful details and service status.</p></div>
      <div class="info-card"><h3>Supported platforms</h3><p>Facebook · YouTube · Spotify</p></div>
      <div class="info-card"><h3>API service</h3><p>MediaDown connects to the downloader API supplied for this project. The API may be unavailable, change its response format, or apply its own limits.</p><button class="icon-btn" id="checkApi" style="width:auto;padding:0 14px;margin-top:8px">Check service status</button><div id="apiStatus" style="font-size:12px;color:var(--muted);margin-top:10px"></div></div>
      <div class="info-card"><h3>Version</h3><p>MediaDown Web · Version 1.0.0</p></div>
    </section>
  </main>
</div>
<div class="toast" id="toast"></div>
<script>
  const $ = (id) => document.getElementById(id);
  let selectedPlatform = "facebook";
  let rememberHistory = localStorage.getItem("md-history") !== "false";
  let historyItems = JSON.parse(localStorage.getItem("md-history-items") || "[]");

  function toast(message) {
    const el = $("toast"); el.textContent = message; el.classList.add("show");
    setTimeout(() => el.classList.remove("show"), 2300);
  }
  function setTheme(theme) {
    document.documentElement.dataset.theme = theme;
    localStorage.setItem("md-theme", theme);
    const dark = theme === "dark";
    $("themeToggle").classList.toggle("on", dark);
    $("themeQuick").textContent = dark ? "☼" : "☾";
  }
  setTheme(localStorage.getItem("md-theme") || "dark");
  $("historyToggle").classList.toggle("on", rememberHistory);

  function navigate(page) {
    document.querySelectorAll(".page").forEach(el => el.classList.toggle("active", el.id === `page-${page}`));
    document.querySelectorAll(".nav button").forEach(el => el.classList.toggle("active", el.dataset.page === page));
    $("crumbName").textContent = page.charAt(0).toUpperCase() + page.slice(1);
    if (page === "history") renderHistory();
    window.scrollTo({top:0,behavior:"smooth"});
  }
  document.querySelectorAll(".nav button").forEach(btn => btn.addEventListener("click", () => navigate(btn.dataset.page)));

  document.querySelectorAll(".platform").forEach(btn => btn.addEventListener("click", () => {
    selectedPlatform = btn.dataset.platform;
    document.querySelectorAll(".platform").forEach(item => item.classList.toggle("selected", item === btn));
    $("qualityRow").style.display = selectedPlatform === "youtube" ? "flex" : "none";
    $("mediaUrl").placeholder = selectedPlatform === "facebook" ? "Paste a Facebook video link..." : selectedPlatform === "youtube" ? "Paste a YouTube video link..." : "Paste a Spotify track link...";
    $("status").className = "status"; $("status").textContent = "";
  }));
  $("qualityRow").style.display = "none";

  $("themeQuick").addEventListener("click", () => setTheme(document.documentElement.dataset.theme === "dark" ? "light" : "dark"));
  $("themeToggle").addEventListener("click", () => setTheme(document.documentElement.dataset.theme === "dark" ? "light" : "dark"));
  $("historyToggle").addEventListener("click", () => {
    rememberHistory = !rememberHistory; localStorage.setItem("md-history", String(rememberHistory));
    $("historyToggle").classList.toggle("on", rememberHistory);
    if (!rememberHistory) { historyItems = []; localStorage.removeItem("md-history-items"); }
    toast(rememberHistory ? "History enabled" : "History disabled");
  });
  $("clearHistory").addEventListener("click", () => {
    historyItems = []; localStorage.removeItem("md-history-items"); renderHistory(); toast("History cleared");
  });

  function safeText(value) {
    if (typeof value === "string" || typeof value === "number" || typeof value === "boolean") return String(value);
    return "";
  }
  
  function findLinks(value, found = [], depth = 0) {
    if (depth > 5 || value == null) return found;
    if (typeof value === "string") {
      // TINANGGAP NA RIN ANG RELATIVE URL TULAD NG /api/proxy
      if (/^(https?:\/\/|\/api\/)/i.test(value) && !found.includes(value)) {
        found.push(value);
      }
      return found;
    }
    if (Array.isArray(value)) { value.forEach(item => findLinks(item, found, depth + 1)); return found; }
    if (typeof value === "object") {
      for (const [key, child] of Object.entries(value)) {
        if (typeof child === "string" && /url|link|download|file|src/i.test(key)) findLinks(child, found, depth + 1);
        else if (typeof child === "object") findLinks(child, found, depth + 1);
      }
    }
    return found;
  }

  function showStatus(message, type = "") {
    const el = $("status"); el.className = `status show ${type}`; el.textContent = message;
  }
  
  function renderResult(data) {
    const status = $("status");
    status.className = "status show success";
    const title = document.createElement("div");
    title.textContent = "Request completed. Your file is ready.";
    title.style.marginBottom = "10px";
    status.appendChild(title);
    
    const links = findLinks(data);
    if (links.length) {
      const list = document.createElement("div"); list.className = "result-links";
      links.slice(0, 8).forEach((link, index) => {
        const a = document.createElement("a"); 
        a.className = "result-link"; 
        a.href = link; 
        
        // KUNG PROXY LINK, I-FORCE DOWNLOAD
        if(link.includes("/api/proxy")) {
            a.setAttribute("download", "video.mp4");
        } else {
            a.target = "_blank"; 
            a.rel = "noopener noreferrer";
        }

        const label = document.createElement("span"); 
        label.textContent = link.includes("/api/proxy") ? "⬇️ Click to Download Video (MP4)" : `Download / result ${index + 1}`;
        
        const action = document.createElement("b"); 
        action.textContent = link.includes("/api/proxy") ? "Save" : "Open ↗";
        
        a.append(label, action); list.appendChild(a);
      });
      status.appendChild(list);
    } else {
      const note = document.createElement("p"); note.textContent = "The API responded, but no recognizable download URL was found. Raw response:";
      status.appendChild(note);
      const pre = document.createElement("pre"); pre.textContent = JSON.stringify(data, null, 2).slice(0, 7000); status.appendChild(pre);
    }
  }

  function addHistory(url, platform) {
    if (!rememberHistory) return;
    historyItems.unshift({url, platform, time: new Date().toLocaleString()});
    historyItems = historyItems.slice(0, 30);
    localStorage.setItem("md-history-items", JSON.stringify(historyItems));
  }
  function renderHistory() {
    const root = $("historyList"); root.replaceChildren();
    if (!historyItems.length) {
      const empty = document.createElement("div"); empty.className = "history-empty";
      const icon = document.createElement("div"); icon.textContent = "◷";
      const title = document.createElement("strong"); title.textContent = "No recent requests";
      const p = document.createElement("p"); p.textContent = "Your recent download requests will appear here.";
      empty.append(icon, title, p); root.appendChild(empty); return;
    }
    historyItems.forEach(item => {
      const card = document.createElement("div"); card.className = "setting-card";
      const row = document.createElement("div"); row.className = "setting-row";
      const content = document.createElement("div");
      const strong = document.createElement("strong"); strong.textContent = item.platform;
      const p = document.createElement("p"); p.textContent = item.url;
      const time = document.createElement("p"); time.textContent = item.time;
      content.append(strong, p, time); row.appendChild(content); card.appendChild(row); root.appendChild(card);
    });
  }

  $("downloadBtn").addEventListener("click", async () => {
    const url = $("mediaUrl").value.trim();
    if (!url) { showStatus("Paste a link first.", "error"); $("mediaUrl").focus(); return; }
    const button = $("downloadBtn"); button.disabled = true; button.textContent = "Processing…";
    $("status").className = "status"; $("status").replaceChildren();
    showStatus("Contacting the downloader service. This may take a few seconds…");
    try {
      const response = await fetch(`/api/download/${selectedPlatform}`, {
        method: "POST", headers: {"Content-Type":"application/json"},
        body: JSON.stringify({url, quality: $("quality").value})
      });
      const payload = await response.json();
      if (!response.ok || !payload.ok) throw new Error(payload.error || "Download request failed.");
      addHistory(url, selectedPlatform);
      $("status").replaceChildren();
      renderResult(payload.result);
    } catch (error) {
      showStatus(error.message || "Something went wrong. Please try again.", "error");
    } finally {
      button.disabled = false; button.textContent = "↓  Download";
    }
  });
  $("mediaUrl").addEventListener("keydown", e => { if (e.key === "Enter") $("downloadBtn").click(); });
  $("checkApi").addEventListener("click", async () => {
    $("apiStatus").textContent = "Checking…";
    try {
      const response = await fetch("/api/health"); const data = await response.json();
      $("apiStatus").textContent = data.ok ? "✓ MediaDown server is online. This does not guarantee that the external downloader API is available." : "Service unavailable.";
    } catch { $("apiStatus").textContent = "Could not reach MediaDown server."; }
  });
</script>
</body>
</html>
